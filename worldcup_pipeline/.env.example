# Data Sources
WORLDCUP_DATA_URL=https://public.tableau.com/app/sample-data/world_cup_results.xlsx
TEMPERATURE_DATA_URL=https://ourworldindata.org/grapher/average-monthly-surface-temperature.zip?v=1&csvType=full&useColumnShortNames=false

# Database Configuration (Optional - for PostgreSQL/SQLite)
DB_TYPE=sqlite  # sqlite or postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=worldcup_analytics
DB_USER=your_user
DB_PASSWORD=your_password

# Pipeline Settings
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
OUTPUT_PATH=data/output

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/pipeline.log

# Processing
CHUNK_SIZE=10000
MAX_RETRIES=3
TIMEOUT_SECONDS=30